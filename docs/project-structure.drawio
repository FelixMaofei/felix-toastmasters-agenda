<mxfile host="app.diagrams.net" modified="2026-09-02T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="felix-agenda-project-structure" name="项目文件架构">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Felix Toastmasters Agenda｜项目文件架构" style="text;html=1;strokeColor=none;fillColor=none;fontSize=32;fontStyle=1;fontColor=#073B57;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="900" height="55" as="geometry"/></mxCell>
        <mxCell id="root" value="&lt;b&gt;felix-toastmasters-agenda/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#004165;strokeColor=#004165;fontColor=#FFFFFF;fontSize=21;" vertex="1" parent="1"><mxGeometry x="560" y="135" width="680" height="72" as="geometry"/></mxCell>
        <mxCell id="runtime" value="&lt;b style='font-size:20px'&gt;① 统一运行包&lt;/b&gt;&lt;br&gt;安装到 Agent，普通任务真正使用&lt;br&gt;&lt;br&gt;&lt;b&gt;SKILL.md&lt;/b&gt;　每次执行的沟通与工作流&lt;br&gt;&lt;b&gt;agents/openai.yaml&lt;/b&gt;　名称、简介、默认提示词&lt;br&gt;&lt;br&gt;&lt;b&gt;scripts/&lt;/b&gt;&lt;br&gt;run_agenda.py　总入口&lt;br&gt;simple_input.py　输入和缺项&lt;br&gt;build_agenda.py　业务、顺序和时间&lt;br&gt;agenda_renderer.py　唯一排版器&lt;br&gt;export_a4.py　Chrome A4检查&lt;br&gt;&lt;br&gt;&lt;b&gt;assets/ + profiles/&lt;/b&gt;&lt;br&gt;CSS、官方 Logo、离线字体、许可证与授权公开的内置俱乐部资料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F5;strokeColor=#AFC5CE;fontColor=#073B57;fontSize=15;spacing=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="250" width="550" height="680" as="geometry"/></mxCell>
        <mxCell id="git" value="&lt;b style='font-size:20px'&gt;② Git 仓库维护资料&lt;/b&gt;&lt;br&gt;会上传 Git，但普通会单不会读取&lt;br&gt;&lt;br&gt;&lt;b&gt;README.md&lt;/b&gt;　人类项目说明和安装&lt;br&gt;&lt;b&gt;references/input-contract.md&lt;/b&gt;　复杂字段手册&lt;br&gt;&lt;b&gt;docs/&lt;/b&gt;　架构说明、运行流程图、文件架构图、SKILL.md指令架构图&lt;br&gt;&lt;b&gt;examples/&lt;/b&gt;　测试夹具和明源云匿名完整示例&lt;br&gt;&lt;b&gt;tests/&lt;/b&gt;　业务、渲染、导出、交付和打包回归&lt;br&gt;&lt;b&gt;package_local.py&lt;/b&gt;　按白名单制作安装包&lt;br&gt;&lt;b&gt;.gitignore&lt;/b&gt;　排除缓存、临时输出和构建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F3F4;strokeColor=#C8D3D7;fontColor=#073B57;fontSize=15;spacing=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="625" y="250" width="665" height="680" as="geometry"/></mxCell>
        <mxCell id="outside" value="&lt;b style='font-size:20px'&gt;③ 项目文件夹之外&lt;/b&gt;&lt;br&gt;不上传 Git，也不放进运行包&lt;br&gt;&lt;br&gt;&lt;b&gt;用户本机私有 Profile&lt;/b&gt;&lt;br&gt;~/.toastmasters-agenda/profiles/&lt;br&gt;未授权公开或用户自定义的俱乐部资料&lt;br&gt;&lt;br&gt;&lt;b&gt;独立验证集&lt;/b&gt;&lt;br&gt;跨版本真实场景比较&lt;br&gt;&lt;br&gt;&lt;b&gt;V3教学归档&lt;/b&gt;&lt;br&gt;设计演进、旧视觉和失败版本&lt;br&gt;&lt;br&gt;&lt;b&gt;本地生成与发布产物&lt;/b&gt;&lt;br&gt;每期文件、运行目录、Release ZIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F3;strokeColor=#D7B7BD;fontColor=#073B57;fontSize=15;spacing=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1320" y="250" width="435" height="680" as="geometry"/></mxCell>
        <mxCell id="footer" value="&lt;b&gt;最终上传 Git = ① 的源码与资源 + ② 的维护资料&lt;/b&gt;&lt;br&gt;安装包只从①制作；③始终留在本地。授权公开的资料可复用，私有资料不上传。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D7DEE1;fontColor=#772432;fontSize=17;spacing=16;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="965" width="1710" height="92" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="root" target="runtime" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="root" target="git" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="root" target="outside" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
