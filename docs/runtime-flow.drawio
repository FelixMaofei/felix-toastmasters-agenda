<mxfile host="app.diagrams.net" modified="2026-09-02T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="felix-agenda-runtime-flow" name="运行流程">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Felix Toastmasters Agenda｜运行流程" style="text;html=1;strokeColor=none;fillColor=none;fontSize=32;fontStyle=1;fontColor=#073B57;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="800" height="55" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Agent 负责理解与沟通，程序保证事实和时间，单一排版器负责 A4，Profile 负责下次少问" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=#677984;" vertex="1" parent="1"><mxGeometry x="60" y="85" width="1000" height="35" as="geometry"/></mxCell>
        <mxCell id="runtime" value="&lt;b&gt;统一运行包｜Codex、WorkBuddy、豆包使用同一份&lt;/b&gt;" style="swimlane;html=1;rounded=1;startSize=48;horizontal=1;fillColor=#FFFFFF;strokeColor=#AFC2CA;dashed=1;fontColor=#772432;fontSize=17;" vertex="1" parent="1"><mxGeometry x="45" y="132" width="1510" height="625" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;用户输入&lt;/b&gt;&lt;br&gt;&lt;br&gt;角色接龙&lt;br&gt;本期变化与自然语言反馈" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#DEC477;fontColor=#073B57;fontSize=16;spacing=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="75" y="205" width="225" height="135" as="geometry"/></mxCell>
        <mxCell id="agent" value="&lt;b&gt;SKILL.md + Agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;多轮沟通、识别缺项&lt;br&gt;过滤默认不展示的宣传文案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F5;strokeColor=#AFC5CE;fontColor=#073B57;fontSize=16;spacing=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="350" y="205" width="245" height="135" as="geometry"/></mxCell>
        <mxCell id="meeting" value="&lt;b&gt;meeting.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;只保存本期事实&lt;br&gt;用户不接触内部 JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F1F2;strokeColor=#D8B6BD;fontColor=#073B57;fontSize=16;spacing=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="645" y="205" width="210" height="135" as="geometry"/></mxCell>
        <mxCell id="confirm" value="&lt;b&gt;confirm｜内容确认&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入校验 + Profile 合并&lt;br&gt;流程组装 + 时间闭合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#004165;strokeColor=#004165;fontColor=#FFFFFF;fontSize=16;spacing=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="905" y="205" width="245" height="135" as="geometry"/></mxCell>
        <mxCell id="text" value="&lt;b&gt;完整文字确认稿&lt;/b&gt;&lt;br&gt;&lt;br&gt;agenda.md + 计算事实&lt;br&gt;内容编号 facts_sha256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7F9;strokeColor=#AFC5CE;fontColor=#073B57;fontSize=16;spacing=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1200" y="205" width="285" height="135" as="geometry"/></mxCell>
        <mxCell id="profile" value="&lt;b&gt;内置＋本地 Profile&lt;/b&gt;&lt;br&gt;&lt;br&gt;公开资料随 Skill 安装&lt;br&gt;本地资料优先覆盖&lt;br&gt;本期事实始终优先" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF3D5;strokeColor=#D5AA32;fontColor=#073B57;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="420" width="230" height="185" as="geometry"/></mxCell>
        <mxCell id="user-confirm" value="&lt;b&gt;用户确认全部文字&lt;/b&gt;&lt;br&gt;&lt;br&gt;内容变化：回到 confirm&lt;br&gt;确认后：携带内容编号生图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F1F2;strokeColor=#D8B6BD;fontColor=#073B57;fontSize=16;spacing=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="245" height="145" as="geometry"/></mxCell>
        <mxCell id="image" value="&lt;b&gt;image｜生图&lt;/b&gt;&lt;br&gt;&lt;br&gt;核对内容编号&lt;br&gt;不再重算文字" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#004165;strokeColor=#004165;fontColor=#FFFFFF;fontSize=16;spacing=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="715" y="430" width="220" height="145" as="geometry"/></mxCell>
        <mxCell id="renderer" value="&lt;b&gt;单一 Renderer&lt;/b&gt;&lt;br&gt;&lt;br&gt;统一 CSS、官方 Logo&lt;br&gt;离线字体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F5;strokeColor=#AFC5CE;fontColor=#073B57;fontSize=16;spacing=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="985" y="430" width="225" height="145" as="geometry"/></mxCell>
        <mxCell id="export" value="&lt;b&gt;Chrome A4 检查&lt;/b&gt;&lt;br&gt;&lt;br&gt;一页、字体、裁切、隐藏&lt;br&gt;生成预览 PNG / PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6F1;strokeColor=#B7D0BF;fontColor=#073B57;fontSize=16;spacing=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1260" y="430" width="225" height="145" as="geometry"/></mxCell>
        <mxCell id="modify" value="&lt;b&gt;用户自然语言修改&lt;/b&gt;&lt;br&gt;内容回 confirm；纯视觉回 image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7F9;strokeColor=#AFC5CE;fontColor=#073B57;fontSize=16;" vertex="1" parent="1"><mxGeometry x="420" y="635" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="final" value="&lt;b&gt;final｜原样交付&lt;/b&gt;&lt;br&gt;不重算、不重排，复制已看版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#772432;strokeColor=#772432;fontColor=#FFFFFF;fontSize=16;" vertex="1" parent="1"><mxGeometry x="780" y="635" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="files" value="&lt;b&gt;交付给用户：PDF / PNG&lt;/b&gt;&lt;br&gt;可直接使用，预览与最终内容一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#DEC477;fontColor=#073B57;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1140" y="635" width="345" height="82" as="geometry"/></mxCell>
        <mxCell id="git" value="&lt;b&gt;Git 源码仓库中保留，但不进入运行包&lt;/b&gt;&lt;br&gt;&lt;br&gt;README　输入合同　架构文档与图　匿名完整示例　当前测试　打包脚本&lt;br&gt;&lt;br&gt;用于维护、教学、公开检查和回归；普通会单任务不会读取这些内容。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F3;strokeColor=#CAD5D9;fontColor=#073B57;fontSize=16;spacing=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="792" width="1010" height="155" as="geometry"/></mxCell>
        <mxCell id="outside" value="&lt;b&gt;Git 与运行包之外&lt;/b&gt;&lt;br&gt;&lt;br&gt;私有 Profile　独立验证集　历史版本&lt;br&gt;&lt;br&gt;未授权公开的资料留在本地，也避免日常 Agent 读取维护噪音。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F5;strokeColor=#D8B6BD;fontColor=#073B57;fontSize=16;spacing=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1095" y="792" width="460" height="155" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="user" target="agent" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="agent" target="meeting" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="meeting" target="confirm" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="confirm" target="text" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ep" value="自动补充长期资料" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeWidth=2;strokeColor=#3D738C;endArrow=block;endFill=1;fontSize=13;fontColor=#536670;" edge="1" source="profile" target="confirm" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="et" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeWidth=2;strokeColor=#3D738C;endArrow=block;endFill=1;" edge="1" source="text" target="user-confirm" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ei" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="user-confirm" target="image" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="image" target="renderer" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="renderer" target="export" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ef" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="export" target="final" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eff" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="final" target="files" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
