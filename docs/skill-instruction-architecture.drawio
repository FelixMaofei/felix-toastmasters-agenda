<mxfile host="app.diagrams.net" modified="2026-09-02T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="felix-agenda-skill-instruction-architecture" name="SKILL.md指令架构">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Felix Toastmasters Agenda｜SKILL.md 指令架构" style="text;html=1;strokeColor=none;fillColor=none;fontSize=32;fontStyle=1;fontColor=#073B57;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1100" height="55" as="geometry"/></mxCell>
        <mxCell id="root" value="&lt;b style='font-size:21px'&gt;核心价值：继承稳定内容，识别本期变化，重新计算并闭合整场会议&lt;/b&gt;&lt;br&gt;用户只说角色接龙、本期变化和自然语言修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#004165;strokeColor=#004165;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="420" y="132" width="960" height="90" as="geometry"/></mxCell>
        <mxCell id="confirm-input" value="&lt;b style='font-size:20px'&gt;① 内容确认｜怎样和用户沟通&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;先说清当前进度&lt;/b&gt;&lt;br&gt;说明已经识别什么、还缺什么，不重复追问&lt;br&gt;&lt;br&gt;&lt;b&gt;关键缺项显性确认&lt;/b&gt;&lt;br&gt;特殊环节四要素；即兴与点评时长；合影休息和真情分享建议值；点评顺序&lt;br&gt;&lt;br&gt;&lt;b&gt;可选内容与 Profile&lt;/b&gt;&lt;br&gt;宣传亮点默认不展示；内置公开 Profile 可沿用，本地 Profile 优先，本期事实最高优先" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F5;strokeColor=#AFC5CE;fontColor=#073B57;fontSize=15;spacing=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="260" width="535" height="590" as="geometry"/></mxCell>
        <mxCell id="confirm-program" value="&lt;b style='font-size:20px'&gt;② confirm｜怎样形成可靠文字稿&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;内部简易输入&lt;/b&gt;&lt;br&gt;Agent 写 simple_version: 1 meeting.json；用户不配置技术字段&lt;br&gt;&lt;br&gt;&lt;b&gt;运行 confirm&lt;/b&gt;&lt;br&gt;Profile 合并 → 缺项与超时 → 流程组装 → 时间闭合 → agenda.md + facts_sha256&lt;br&gt;&lt;br&gt;&lt;b&gt;三种结果&lt;/b&gt;&lt;br&gt;needs_input：继续沟通，不生图&lt;br&gt;超时：用户明确同意后才继续&lt;br&gt;text_confirmation_ready：完整展示 agenda.md，核对全部文字" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#DEC477;fontColor=#073B57;fontSize=15;spacing=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="632" y="260" width="535" height="590" as="geometry"/></mxCell>
        <mxCell id="image-final" value="&lt;b style='font-size:20px'&gt;③ image + final｜怎样生图与交付&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;确认文字是分界线&lt;/b&gt;&lt;br&gt;确认前不启动浏览器；文字变化回到 confirm&lt;br&gt;&lt;br&gt;&lt;b&gt;运行 image&lt;/b&gt;&lt;br&gt;只接受已确认的 computed.json + facts_sha256；不重解析、不读 Profile、不重算文字；输出一页 A4 PNG/PDF&lt;br&gt;&lt;br&gt;&lt;b&gt;修改与交付&lt;/b&gt;&lt;br&gt;内容修改回 confirm；纯视觉修改回 image&lt;br&gt;可以／就这样／直接导出 → final 原样复制已看文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6F1;strokeColor=#B7D0BF;fontColor=#073B57;fontSize=15;spacing=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1219" y="260" width="535" height="590" as="geometry"/></mxCell>
        <mxCell id="foundation" value="&lt;b style='font-size:18px'&gt;四条边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent&lt;/b&gt;：理解与沟通　　&lt;b&gt;业务程序&lt;/b&gt;：按确认时长计算，不反推　　&lt;b&gt;Renderer&lt;/b&gt;：官方 Logo、一页 A4、无裁切　　&lt;b&gt;成品&lt;/b&gt;：中文／英文／双语 PDF+PNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D7DEE1;fontColor=#073B57;fontSize=15;spacing=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="45" y="885" width="1710" height="145" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="root" target="confirm-input" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="root" target="confirm-program" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="root" target="image-final" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="confirm-input" target="confirm-program" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#C89B2B;endArrow=block;endFill=1;" edge="1" source="confirm-program" target="image-final" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
